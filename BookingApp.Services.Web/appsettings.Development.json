{
  "ConnectionStrings": {
    "Database": ""
  },
  "BackgroundJobs": {
    "CompleteBookings": {
      "IntervalSeconds": 60,
      "PageSize": 100,
      "Enabled": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Quartz": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  }
}
