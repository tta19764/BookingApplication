    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hallId\": \"{{conferenceHallId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\",\n  \"amenities\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Booking is created', function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const bookingId = body.data && body.data.bookingId;",
                  "pm.environment.set('bookingId', bookingId);",
                  "",
                  "pm.test('Booking id and total price are returned', function () {",
                  "    pm.expect(bookingId).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data.totalPrice).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Overlapping Booking Should Fail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hallId\": \"{{conferenceHallId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"startTime\": \"11:00\",\n  \"endTime\": \"12:00\",\n  \"amenities\": [1]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Overlapping booking is rejected', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
