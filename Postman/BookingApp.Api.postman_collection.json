    {
      "name": "Conference Halls",
      "item": [
        {
          "name": "Create Conference Hall",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Hall\",\n  \"capacity\": 75,\n  \"hourlyRate\": 2600,\n  \"currencyCode\": \"UAH\",\n  \"amenities\": [1, 2, 3]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/conference-halls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "conference-halls"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conference hall is created', function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const hallId = body.data || body.value;",
                  "pm.environment.set('conferenceHallId', hallId);",
                  "",
                  "pm.test('Conference hall id is returned', function () {",
                  "    pm.expect(hallId).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Conference Halls Paginated",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/conference-halls?page=1&pageSize=20",
